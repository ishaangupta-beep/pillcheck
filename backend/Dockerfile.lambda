# PillCheck on AWS Lambda (container image, Graviton / arm64). Build from the project root:
#   docker buildx build --platform linux/arm64 -f backend/Dockerfile.lambda -t pillcheck-lambda .
# Local test (the base image ships the Lambda runtime emulator):
#   docker run -p 9000:8080 pillcheck-lambda
#   curl -XPOST localhost:9000/2015-03-31/functions/function/invocations -d '{"pillcheck":"warm"}'

# ---- 1. web app
FROM node:22-slim AS web
WORKDIR /web
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY frontend/ ./
RUN npm run build

# ---- 2. API + OpenCV 5 + agent
FROM public.ecr.aws/lambda/python:3.12
COPY backend/requirements-lambda.txt ./
RUN pip install --no-cache-dir -r requirements-lambda.txt --target "${LAMBDA_TASK_ROOT}"

# OpenCV 5 ALIKED + LightGlue models, checksum-verified, baked into the image.
COPY backend/scripts/download_models.py ${LAMBDA_TASK_ROOT}/scripts/
RUN python ${LAMBDA_TASK_ROOT}/scripts/download_models.py /opt/models

COPY backend/pillcheck/ ${LAMBDA_TASK_ROOT}/pillcheck/
COPY backend/demo_assets/ ${LAMBDA_TASK_ROOT}/demo_assets/
COPY --from=web /web/dist/ ${LAMBDA_TASK_ROOT}/static/

ENV PILLCHECK_MODELS_DIR=/opt/models \
    PILLCHECK_STORAGE=aws \
    PILLCHECK_DATA_DIR=/tmp/pillcheck \
    PILLCHECK_MAX_UPLOAD_MB=4

CMD ["pillcheck.lambda_handler.handler"]
