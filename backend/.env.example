# Copy to .env and adjust. Every setting has a working default for local use.

# --- storage: local (SQLite + files in ./data) or aws (DynamoDB + S3)
PILLCHECK_STORAGE=local
# PILLCHECK_DATA_DIR=./data
# PILLCHECK_DDB_TABLE=pillcheck
# PILLCHECK_S3_BUCKET=pillcheck-photos-<your-account>
AWS_REGION=ap-south-1

# --- agent: leave empty for the deterministic planner; set a Bedrock model id
# (one enabled in your account and region) to let a foundation model plan.
PILLCHECK_BEDROCK_MODEL_ID=
# SNS topic for caregiver SMS/email alerts (optional)
# PILLCHECK_SNS_TOPIC_ARN=arn:aws:sns:ap-south-1:123456789012:pillcheck-alerts

# --- API security: when set, every request needs "Authorization: Bearer <token>"
PILLCHECK_API_TOKEN=

# --- patient defaults and dose timing (minutes)
PILLCHECK_TZ=Asia/Kolkata
# PILLCHECK_EARLY_WINDOW_MIN=120
# PILLCHECK_REMINDER_AFTER_MIN=60
# PILLCHECK_CAREGIVER_AFTER_MIN=180
# PILLCHECK_MAX_LATE_MIN=360
# PILLCHECK_REFILL_DAYS=3

# --- vision thresholds (calibrated with eval/run_eval.py)
# PILLCHECK_POPPED_T=2.2
# PILLCHECK_INTACT_T=2.0
# PILLCHECK_IDENTITY_MIN_APPEARANCE=0.62
# PILLCHECK_FEATURES=orb   # force the classic ORB baseline (evaluation only)
